# ============================================================
# Financial Companion — Backend environment variables
# Copy this file to `.env` and fill in real values.
#   cp backend/.env.example backend/.env
# ============================================================

# --- App ---
DEBUG=false
LOG_LEVEL=INFO

# --- Database ---
# Local dev (Docker Postgres from docker-compose.yml):
DATABASE_URL=postgresql+psycopg2://financial:change-me@localhost:5432/financial_companion

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS (JSON array — origins allowed to call this API) ---
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
