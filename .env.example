# ============================================================
# Financial Companion — environment variables
# Copy to `.env` before running:
#   cp .env.example .env
# ============================================================

# --- PostgreSQL (db service) ---
POSTGRES_USER=financial
POSTGRES_PASSWORD=change-me
POSTGRES_DB=financial_companion

# --- Backend ---
# Secret used to sign JWTs — change to a long random string!
JWT_SECRET=change-me-to-a-long-random-string
BACKEND_DEBUG=false
LOG_LEVEL=INFO
APP_NAME=Financial Companion API
APP_VERSION=1.0.0

# JSON array of allowed browser origins (frontend dev server + production)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost"]
